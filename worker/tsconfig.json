{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2022",
    "outDir": "../dist/worker",
    "rootDir": "..",
    "noEmit": false,
    "incremental": false,
    "jsx": "preserve",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true
  },
  "include": ["**/*.ts", "../lib/**/*.ts", "../prisma/**/*.ts"],
  "exclude": ["../node_modules", "../.next", "../dist"]
}
